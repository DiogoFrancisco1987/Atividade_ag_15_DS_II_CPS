<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.ContratacaoHospedagem"
             Title="ContratacaoHospedagem"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}"
             >
    
    <VerticalStackLayout VerticalOptions="CenterAndExpand"
                         Padding="10"
                         Spacing="10">
        <Label 
            Text="Cadastro de esporte."
            FontFamily="Indie"
            FontSize="40"
            TextColor="{StaticResource Primary}"
       
            />

        <Frame Padding="10" BackgroundColor="Black">
            <VerticalStackLayout>

                <HorizontalStackLayout HorizontalOptions="Center" Spacing="20">
                      <Label
                             Text="Participantes"
                             FontFamily="Indie"
                             FontSize="20"/>

                    <Label 
                             TextColor="Yellow"
                             Text="{Binding Value}"
                           BindingContext="{x:Reference stp_participantes}"/>
                    
                    <Stepper 
                             x:Name="stp_participantes"
                             Minimum="10"
                             Maximum="30"
                             Increment="1"
                             BackgroundColor="Gray"
                             />

                </HorizontalStackLayout>


                <Frame Padding="10"
                       Margin="10" 
                       BorderColor="White">


                    <VerticalStackLayout>
                         <Label Text="Escolha sua quadra"
                       FontFamily="Indie"
                       FontSize="20"/>

                          <Picker x:Name="pck_quadra"
                        
                        ItemDisplayBinding="{Binding Descricao}"
                        FontFamily="Indie"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="20"
                        BackgroundColor="Grey"          />

                        <Label Text="Escolha seu esporte"
                                 FontFamily="Indie"
                            FontSize="20"/>

                        <Picker x:Name="pck_esporte"   
                              ItemDisplayBinding="{Binding DescricaoEsporte}"
                              FontFamily="Indie"
                             TextColor="White"
                             FontAttributes="Bold"
                              FontSize="20"
                              BackgroundColor="Grey"          />

                    </VerticalStackLayout>
                </Frame>

                <Frame Padding="10"
                       Margin="10" 
                       BorderColor="White">

                    <VerticalStackLayout Spacing="10">
                        
                    <Label Text="Período do Campeonato"
                           FontFamily="Indie"
                           FontSize="20"
                           TextTransform="Uppercase"/>


                        <HorizontalStackLayout HorizontalOptions="CenterAndExpand" Spacing="15">
                        <Label Text="Início:"
                               FontFamily="Indie"
                               FontSize="20"/>
                            <DatePicker x:Name="dtpck_checkin"
                                        Format="dd/MM/yyyy"
                                        BackgroundColor="CadetBlue"
                                        TextColor="Black"
                                        FontSize="20"
                                        DateSelected="dtpck_checkin_DateSelected"/>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout HorizontalOptions="CenterAndExpand" Spacing="15">
                            <Label Text="Fim:"
                                   FontFamily="Indie"
                                   FontSize="20"/>
                            <DatePicker x:Name="dtpck_checkout"
                                        TextColor="Black"
                                        Format="dd/MM/yyyy"
                                        BackgroundColor="Orange"
                                        FontSize="20"
                                       DateSelected="dtpck_checkout_DateSelected"/>
                        </HorizontalStackLayout>


                    </VerticalStackLayout>

                </Frame>

                <Button Text="Avançar"
                        Margin="0,0,0,10"
                        TextColor="Black"
                        BackgroundColor="{StaticResource Verde}"
                        Clicked="Button_Clicked" 
                        FontFamily="Indie"
                        FontAttributes="Bold"
                        FontSize="20"
                        />
                
                  

            </VerticalStackLayout>
            
        </Frame>

        <Button Text="Sobre" Margin="10,10,10,10"
                BackgroundColor="Grey"
                TextColor="Black"
                Clicked="OnSobreClicked"   
                FontFamily="Indie"
                FontAttributes="Bold"
                FontSize="20"
           />

    </VerticalStackLayout>

</ContentPage>