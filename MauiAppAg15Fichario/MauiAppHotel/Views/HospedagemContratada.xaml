<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.HospedagemContratada"
             Title="HospedagemContratada"
             NavigationPage.HasNavigationBar="false"
             BackgroundColor="{StaticResource Gray100}"
             >


    <VerticalStackLayout VerticalOptions="CenterAndExpand">

        <Label 
            Text="Esporte Selecionado."
            FontFamily="Indie"
            FontSize="40"
            TextColor="{StaticResource Primary}"
       
            /> 

        <Label Text="{Binding QuadraSelecionada.Descricao}"
               TextColor="Black"
               FontFamily="Indie"
               FontSize="30"
               HorizontalTextAlignment="Center"
               
               />

        <Label Text="{Binding EsporteSelecionado.DescricaoEsporte}"
               TextColor="Black"
               FontFamily="Indie"
               FontSize="30"
               HorizontalTextAlignment="Center"
               
               />

        <Frame Margin="10">
               
               <StackLayout Orientation="Horizontal" >

                <HorizontalStackLayout HorizontalOptions="CenterAndExpand" Spacing="10">
                               <Label Text="Participantes: "
                                       FontFamily="Indie"
                                      TextColor="White"
                                    FontSize="20"/>
                            
                               <Label Text="{Binding Qntparticipantes}"
                              TextColor="White"
                                      FontFamily="Indie"
                                      FontSize="20"/>

                         </HorizontalStackLayout>




            </StackLayout>


        </Frame>

        <Frame Margin="10">
            <Grid ColumnDefinitions="*, *, *"
                  RowDefinitions="Auto,Auto">
                <Label Grid.Row="0" Grid.Column="0" Text="Início:"  FontFamily="Indie" FontSize="20"/>
                <Label Grid.Row="0" Grid.Column="1" Text="Fim:" FontFamily="Indie" FontSize="20" />
                <Label Grid.Row="0" Grid.Column="2" Text="Período:" FontFamily="Indie" FontSize="20" />


                <Label Grid.Row="1" Grid.Column="0" Text="{Binding DataCheckIn, StringFormat='{}{0:dd/MM/yyyy}'}" FontFamily="Indie" FontSize="20" />
                <Label Grid.Row="1" Grid.Column="1" Text="{Binding DataCheckOut, StringFormat='{}{0:dd/MM/yyyy}'}" FontFamily="Indie" FontSize="20"/>
                <Label Grid.Row="1" Grid.Column="2" Text="{Binding Estadia}" FontFamily="Indie" FontSize="20"/>
            </Grid>
            
            
            
        </Frame>

        <Frame Margin="10">
            <HorizontalStackLayout HorizontalOptions="CenterAndExpand" Spacing="10">

                <Label Text="Valor total: " FontFamily="Indie" FontSize="20"/>
                <Label Text="{Binding ValorTotal, StringFormat='{}{0:c}'}" FontFamily="Indie" FontSize="20"/>
                                
            </HorizontalStackLayout>
                        
        </Frame>

        <Button Text="Voltar"
                BackgroundColor="Gray"
                TextColor="Black"
                HorizontalOptions="Center"
                Clicked="Button_Clicked"
                FontFamily="Indie" FontSize="20" FontAttributes="Bold"/>


    </VerticalStackLayout>

</ContentPage>